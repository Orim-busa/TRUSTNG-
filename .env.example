# TrustNG local development defaults
TRUSTNG_ENV=sandbox
TRUSTNG_API_KEY=REPLACE_WITH_A_PRIVATE_LOCAL_API_KEY

# Required for secure recipient OTP hashing.
# Generate privately with: openssl rand -hex 32
TRUSTNG_OTP_PEPPER=REPLACE_WITH_A_PRIVATE_RANDOM_SECRET

# Database-backed functionality
DATABASE_URL=REPLACE_WITH_YOUR_POSTGRESQL_CONNECTION_STRING

# Sandbox sends neither real SMS nor real email
TRUSTNG_PHONE_DELIVERY_MODE=sandbox
TRUSTNG_EMAIL_DELIVERY_MODE=sandbox

# Sendozi configuration — only when deliberately testing the SMS provider
# Use a Sendozi test key in sandbox; test requests do not deliver real SMS.
# TRUSTNG_PHONE_DELIVERY_MODE=sendozi
# SENDOZI_API_KEY=sk_test_REPLACE_WITH_YOUR_TEST_KEY
# SENDOZI_TRANSACTIONAL_SENDER=YOUR_APPROVED_SENDER

# SMTP configuration — required for real email delivery
# TRUSTNG_EMAIL_DELIVERY_MODE=smtp
# SMTP_HOST=YOUR_SMTP_HOST
# SMTP_PORT=587
# SMTP_USERNAME=YOUR_SMTP_USERNAME
# SMTP_PASSWORD=YOUR_SMTP_PASSWORD
# EMAIL_FROM=YOUR_VERIFIED_SENDER_EMAIL
# SMTP_USE_SSL=false
